# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=researchflow
DB_PORT=5432

# API Configuration
API_PORT=8000
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/researchflow

# API Keys
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible fallback.
# Works with OpenAI directly, or compatible providers such as DeepSeek/Qwen/Kimi/OpenRouter when base URL is set.
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini

TAVILY_API_KEY=your_tavily_api_key_here
MODEL_NAME=gpt-4.1-mini
SEARCH_PROVIDER=tavily
SEARCH_MAX_RESULTS=3
TAVILY_SEARCH_DEPTH=advanced
PROVIDER_TIMEOUT_SECONDS=45
CORS_ALLOWED_ORIGINS=*

### docker-compose.yml
